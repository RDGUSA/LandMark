<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LandMark</RootNamespace>
    <AssemblyName>LandMark</AssemblyName>
    <Product>LandMark</Product>
    <!-- Release version; shown in About and in the exe's file properties, and matches the GitHub release tag. -->
    <Version>26.11.2001</Version>
    <Company>RDG Planning &amp; Design, Inc</Company>
    <Copyright>Copyright (c) 2026 RDG Planning &amp; Design, Inc</Copyright>
    <!-- LM badge (True Black, RDG Red bars, white point) at 16-256 px; Assets\app-256.png is the large version. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app-256.png" />
    <Resource Include="Assets\ellipsis-red.png" />
  </ItemGroup>

  <!-- The one package: Microsoft's WebView2 SDK, for the Chromium-based preview and PDF export. The browser
       itself is the WebView2 Runtime that ships with Windows 11 (and comes with Edge updates on Windows 10). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!--
    Internal code signing, the same Sign.bat step as Atlas and RDG Model QC. After a single-file publish, LandMark.exe
    is copied to publish-internal\ and that copy is signed with this machine's Sign.bat. publish\LandMark.exe stays
    unsigned for the public GitHub release, because the certificate is internal only. publish-internal\ is git-ignored.
    Skipped when Sign.bat isn't on the machine, or with -p:SignOutput=false. A failed signature deletes the copy and
    stops the publish, so publish-internal\ never holds an unsigned exe.
  -->
  <PropertyGroup>
    <SignOutput Condition="'$(SignOutput)' == ''">true</SignOutput>
    <SignScript Condition="'$(SignScript)' == ''">C:\users\$(USERNAME)\desktop\Sign.bat</SignScript>
    <InternalPublishDir Condition="'$(InternalPublishDir)' == ''">$(MSBuildProjectDirectory)\publish-internal\</InternalPublishDir>
  </PropertyGroup>

  <Target Name="SignInternalCopy" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true' And '$(SignOutput)' == 'true'">
    <Message Importance="high" Condition="!Exists('$(SignScript)')" Text="LandMark: $(SignScript) isn't on this machine; no signed internal copy was made." />
    <PropertyGroup>
      <_InternalExe>$(InternalPublishDir)$(AssemblyName).exe</_InternalExe>
    </PropertyGroup>
    <Delete Files="$(_InternalExe)" Condition="Exists('$(SignScript)')" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFolder="$(InternalPublishDir)" Condition="Exists('$(SignScript)')" />
    <Exec Command="call &quot;$(SignScript)&quot; &quot;$(_InternalExe)&quot;" Condition="Exists('$(SignScript)')" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="_SignExitCode" />
    </Exec>
    <Delete Files="$(_InternalExe)" Condition="'$(_SignExitCode)' != '' And '$(_SignExitCode)' != '0'" />
    <Error Condition="'$(_SignExitCode)' != '' And '$(_SignExitCode)' != '0'" Text="Signing $(_InternalExe) failed (exit code $(_SignExitCode)); the unsigned copy was removed." />
    <Message Importance="high" Condition="'$(_SignExitCode)' == '0'" Text="LandMark: signed internal copy -> $(_InternalExe)" />
  </Target>

</Project>
