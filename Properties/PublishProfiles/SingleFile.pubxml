<?xml version="1.0" encoding="utf-8"?>
<!--
  One LandMark.exe that uses the .NET 10 Desktop Runtime installed on the PC (not bundled).
  If the runtime is missing, Windows shows a message with a link to download it.
  Publish with:  dotnet publish -p:PublishProfile=SingleFile
  Output:        publish\LandMark.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WebView2's native loader (WebView2Loader.dll) goes inside the exe too; it's unpacked on first run. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugType>none</DebugType>
    <PublishDir>publish\</PublishDir>
  </PropertyGroup>
</Project>
