<UserControl x:Class="LandMark.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LandMark.Controls"
             x:Name="Root">
    <UserControl.Resources>
        <local:HexToBrushConverter x:Key="HexToBrush"/>
        <local:InverseBooleanConverter x:Key="Inverse"/>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <!-- Not clickable while the palette is open, so a click on it closes the palette instead of reopening it. -->
        <ToggleButton x:Name="SwatchButton" Width="44" Height="32" Padding="6" ToolTip="Choose a color"
                      IsHitTestVisible="{Binding IsOpen, ElementName=PalettePopup, Converter={StaticResource Inverse}}">
            <Border CornerRadius="3" BorderThickness="1" Width="26" Height="18"
                    BorderBrush="{DynamicResource ControlStrokeColorSecondaryBrush}"
                    Background="{Binding Hex, ElementName=Root, Converter={StaticResource HexToBrush}}"/>
        </ToggleButton>
        <TextBox Width="96" Margin="6,0,0,0" VerticalContentAlignment="Center" ToolTip="Hex color, e.g. DC3F35"
                 Text="{Binding Hex, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"/>

        <Popup x:Name="PalettePopup" PlacementTarget="{Binding ElementName=SwatchButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
               IsOpen="{Binding IsChecked, ElementName=SwatchButton, Mode=TwoWay}">
            <Border Margin="0,4,12,12" Padding="12,10,8,4" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    Effect="{DynamicResource FlyoutShadow}">
                <ItemsControl x:Name="PaletteGroups">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="0,0,0,4"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding Colors}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Width="224"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Width="24" Height="24" Margin="0,0,4,4" Cursor="Hand" Focusable="False"
                                                    ToolTip="{Binding Label}" Tag="{Binding Hex}" Click="Swatch_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Swatch" CornerRadius="4" BorderThickness="1" BorderBrush="#33000000"
                                                                Background="{Binding Hex, Converter={StaticResource HexToBrush}}"/>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Swatch" Property="BorderThickness" Value="2"/>
                                                                <Setter TargetName="Swatch" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
